<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google" content="notranslate" />
  <meta name="translate" content="no" />
  <title>Vokabeltrainer</title>
  <style>
    :root{
      --bg:#f5f7fb;
      --card:#fff;
      --text:#1f2937;
      --muted:#6b7280;
      --border:#e5e7eb;
      --accent:#2563eb;
      --accent2:#1d4ed8;
      --good:#059669;
      --bad:#dc2626;
      --overlay:rgba(17,24,39,.45);
    }

    *{ box-sizing:border-box; }

    body{
      margin:0;
      padding:16px;
      background:var(--bg);
      color:var(--text);
      font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
    }

    .wrap{
      max-width:760px;
      margin:0 auto;
    }

    .card{
      background:var(--card);
      border:1px solid var(--border);
      border-radius:16px;
      padding:16px;
      margin-bottom:16px;
      box-shadow:0 8px 24px rgba(0,0,0,.05);
    }

    h1{
      font-size:1.5rem;
      margin:0 0 16px;
    }

    h3{
      margin:0 0 12px;
    }

    label{
      display:block;
      font-size:.95rem;
      color:var(--muted);
      margin-bottom:6px;
      font-weight:600;
    }

    select,
    input[type="file"],
    input[type="text"],
    input[type="number"],
    textarea{
      width:100%;
      padding:12px 14px;
      border:1px solid var(--border);
      border-radius:12px;
      background:#fff;
      font-size:1rem;
      color:var(--text);
    }

    textarea{
      min-height:90px;
      resize:vertical;
      font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
    }

    .grid{
      display:grid;
      gap:12px;
    }

    @media (min-width:640px){
      .grid.two{
        grid-template-columns:1fr 1fr;
      }
    }

    .check{
      display:flex;
      gap:10px;
      align-items:center;
      margin-top:8px;
    }

    .check label{
      margin:0;
      color:var(--text);
      font-weight:500;
    }

    button{
      border:0;
      border-radius:12px;
      padding:12px 14px;
      cursor:pointer;
      font-size:1rem;
      font-weight:700;
      color:#fff;
      background:var(--accent);
    }

    button:hover{
      background:var(--accent2);
    }

    button.secondary{
      background:#fff;
      color:var(--text);
      border:1px solid var(--border);
    }

    button.good{
      background:var(--good);
    }

    button.bad{
      background:var(--bad);
    }

    button.edit{
      background:#6b7280;
    }

    .btns{
      display:grid;
      gap:10px;
      margin-top:14px;
    }

    @media (min-width:520px){
      .btns.two{
        grid-template-columns:1fr 1fr;
      }
      .btns.three{
        grid-template-columns:1fr 1fr 1fr;
      }
    }

    .question{
      min-height:96px;
      display:flex;
      align-items:center;
      justify-content:center;
      text-align:center;
      font-size:2rem;
      font-weight:800;
      padding:10px;
    }

    .answer{
      font-size:1.5rem;
      font-weight:800;
      text-align:center;
      margin-bottom:14px;
    }

    .hidden{
      display:none !important;
    }

    .muted{
      color:var(--muted);
    }

    .pill{
      display:inline-block;
      padding:6px 10px;
      border-radius:999px;
      background:#eef2ff;
      border:1px solid var(--border);
      font-weight:700;
    }

    .row{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:8px;
      flex-wrap:wrap;
      margin-bottom:10px;
    }

    .foot{
      font-size:.9rem;
      color:var(--muted);
      text-align:center;
      margin-top:10px;
    }

    .hint{
      font-size:.9rem;
      color:var(--muted);
      line-height:1.45;
      margin-top:10px;
    }

    .edit-area{
      margin-top:14px;
      padding-top:14px;
      border-top:1px solid var(--border);
    }

    .autosave-note{
      font-size:.88rem;
      color:var(--muted);
      margin-top:8px;
    }

    .overlay{
      position:fixed;
      inset:0;
      background:var(--overlay);
      display:flex;
      align-items:center;
      justify-content:center;
      padding:16px;
      z-index:1000;
    }

    .modal{
      width:min(100%, 560px);
      background:#fff;
      border-radius:18px;
      box-shadow:0 20px 60px rgba(0,0,0,.18);
      padding:18px;
      border:1px solid var(--border);
    }

    .modal-title{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:8px;
      margin-bottom:12px;
    }

    .modal-title h3{
      margin:0;
    }

    .close-x{
      background:#fff;
      color:var(--text);
      border:1px solid var(--border);
      padding:8px 12px;
    }

    .status{
      margin-top:10px;
      font-size:.92rem;
      color:var(--muted);
    }

    .status.ok{
      color:#065f46;
    }

    .status.warn{
      color:#92400e;
    }

    .status.err{
      color:#991b1b;
    }
  </style>
</head>
<body class="notranslate">
<div class="wrap notranslate">
  <h1>Vokabeltrainer Deutsch ↔ Spanisch</h1>

  <div class="card">
    <div class="row">
      <h3>Einstellungen</h3>
      <span class="pill" id="countInfo">0 Wörter</span>
    </div>

    <div class="grid two">
      <div>
        <label for="direction">Abfragerichtung</label>
        <select id="direction">
          <option value="de-es">Deutsch → Spanisch</option>
          <option value="es-de">Spanisch → Deutsch</option>
        </select>
      </div>

      <div>
        <label for="category">Kategorie</label>
        <select id="category"></select>
      </div>
    </div>

    <div class="check">
      <input type="checkbox" id="chk1" checked>
      <label for="chk1">Zähler 1</label>
    </div>

    <div class="check">
      <input type="checkbox" id="chk2" checked>
      <label for="chk2">Zähler 2</label>
    </div>

    <div class="check">
      <input type="checkbox" id="chk3" checked>
      <label for="chk3">Zähler 3</label>
    </div>

    <div class="check">
      <input type="checkbox" id="avoidRepeat" checked>
      <label for="avoidRepeat">Nicht direkt dasselbe Wort wiederholen</label>
    </div>

    <div class="btns three">
      <button id="nextBtn">Weiter</button>
      <button id="exportBtn" class="secondary">CSV exportieren</button>
      <button id="addBtn" class="secondary">+ Neues Wort</button>
    </div>
  </div>

  <div class="card">
    <div class="row">
      <h3>Lernkarte</h3>
      <span class="pill" id="levelPill">Stufe: –</span>
    </div>

    <div class="question" id="question">Bitte zuerst eine CSV- oder JSON-Datei importieren.</div>

    <div id="solutionArea" class="hidden">
      <div class="answer" id="answer"></div>

      <p><span id="notes" style="font-weight:700; font-size:1.1rem; color:red;">–</span></p>
      <p><strong>Kategorie:</strong> <span id="catLabel" class="muted">–</span></p>

      <div class="btns two">
        <button id="easierBtn" class="good">− leichter</button>
        <button id="harderBtn" class="bad">+ schwieriger</button>
      </div>

      <div class="btns" style="margin-top:10px;">
        <button id="editBtn" class="edit" type="button">Bearbeiten</button>
      </div>

      <div id="editArea" class="edit-area hidden">
        <label for="editDeutsch">Deutsch</label>
        <input id="editDeutsch" type="text" placeholder="Deutsch">

        <label for="editSpanisch" style="margin-top:10px;">Spanisch</label>
        <input id="editSpanisch" type="text" placeholder="Spanisch">

       <label for="editKategorie" style="margin-top:10px;">Kategorie</label>
<select id="editKategorie">
  <option value="1">Verben</option>
  <option value="2">Substantive</option>
  <option value="3">Adjektive</option>
  <option value="4">Redewendungen</option>
  <option value="5">Diverses</option>
  <option value="6">Sätze</option>
</select>

<label for="editBemerkungen" style="margin-top:10px;">Bemerkungen</label>
<textarea id="editBemerkungen" placeholder="Bemerkungen"></textarea>

        <div class="autosave-note">Änderungen werden automatisch gespeichert.</div>
      </div>
    </div>
  </div>

  <div class="card">
    <h3>Daten importieren</h3>
    <label for="importFile">CSV- oder JSON-Datei importieren</label>
    <input type="file" id="importFile" accept="*/*">
    <p class="hint">
      Unterstützte Formate: CSV oder JSON. Für CSV bitte die Spalten
      <code>Nummer, Deutsch, Spanisch, Kategorie, Zaehler, Bemerkungen</code>
      verwenden.
      Die Daten bleiben nach dem Import im Browser gespeichert.
    </p>
  </div>

  <div class="foot">Tipp: Im Browser-Menü „Zum Startbildschirm hinzufügen“ wählen.</div>
</div>

<!-- Popup Neues Wort -->
<div id="addOverlay" class="overlay hidden">
  <div class="modal">
    <div class="modal-title">
      <h3>Neues Wort hinzufügen</h3>
      <button id="closeAddBtn" class="close-x" type="button">Schließen</button>
    </div>

    <div class="grid two">
      <div>
        <label for="newDeutsch">Deutsch</label>
        <input id="newDeutsch" type="text" placeholder="z. B. gehen">
      </div>
      <div>
        <label for="newSpanisch">Spanisch</label>
        <input id="newSpanisch" type="text" placeholder="z. B. ir">
      </div>
    </div>

    <div class="grid two" style="margin-top:12px;">
      <div>
        <label for="newZaehler">Zähler</label>
        <select id="newZaehler">
          <option value="1">1</option>
          <option value="2" selected>2</option>
          <option value="3">3</option>
        </select>
      </div>
      <div>
        <label for="newKategorie">Kategorie</label>
        <select id="newKategorie">
          <option value="1">Verben</option>
          <option value="2">Substantive</option>
          <option value="3">Adjektive</option>
          <option value="4">Redewendungen</option>
          <option value="5">Diverses</option>
          <option value="6">Sätze</option>
        </select>
      </div>
    </div>

    <div style="margin-top:12px;">
      <label for="newBemerkungen">Bemerkungen</label>
      <textarea id="newBemerkungen" placeholder="optional"></textarea>
    </div>

    <div class="status" id="addStatus">Kategorie wird automatisch vorgeschlagen und kann geändert werden.</div>

    <div class="btns two">
      <button id="saveNewBtn" type="button">Speichern</button>
      <button id="cancelNewBtn" class="secondary" type="button">Abbrechen</button>
    </div>
  </div>
</div>

<script>
const STORAGE_KEY = "vokabeltrainer_data_v10";

const KATEGORIEN_MAP = {
  1: "Verben",
  2: "Substantive",
  3: "Adjektive",
  4: "Redewendungen",
  5: "Diverses",
  6: "Sätze"
};

const KATEGORIEN_REVERSE_MAP = {};
Object.keys(KATEGORIEN_MAP).forEach(key => {
  KATEGORIEN_REVERSE_MAP[KATEGORIEN_MAP[key]] = Number(key);
});

let words = [];
let current = null;
let lastNummer = null;
let showingSolution = false;

const el = {
  direction: document.getElementById("direction"),
  category: document.getElementById("category"),
  chk1: document.getElementById("chk1"),
  chk2: document.getElementById("chk2"),
  chk3: document.getElementById("chk3"),
  avoidRepeat: document.getElementById("avoidRepeat"),
  nextBtn: document.getElementById("nextBtn"),
  exportBtn: document.getElementById("exportBtn"),
  addBtn: document.getElementById("addBtn"),
  importFile: document.getElementById("importFile"),
  question: document.getElementById("question"),
  solutionArea: document.getElementById("solutionArea"),
  answer: document.getElementById("answer"),
  notes: document.getElementById("notes"),
  catLabel: document.getElementById("catLabel"),
  levelPill: document.getElementById("levelPill"),
  countInfo: document.getElementById("countInfo"),
  easierBtn: document.getElementById("easierBtn"),
  harderBtn: document.getElementById("harderBtn"),
  editBtn: document.getElementById("editBtn"),
  editArea: document.getElementById("editArea"),
  editDeutsch: document.getElementById("editDeutsch"),
  editSpanisch: document.getElementById("editSpanisch"),
  editBemerkungen: document.getElementById("editBemerkungen"),
  editKategorie: document.getElementById("editKategorie"),

  addOverlay: document.getElementById("addOverlay"),
  closeAddBtn: document.getElementById("closeAddBtn"),
  cancelNewBtn: document.getElementById("cancelNewBtn"),
  saveNewBtn: document.getElementById("saveNewBtn"),
  newDeutsch: document.getElementById("newDeutsch"),
  newSpanisch: document.getElementById("newSpanisch"),
  newZaehler: document.getElementById("newZaehler"),
  newKategorie: document.getElementById("newKategorie"),
  newBemerkungen: document.getElementById("newBemerkungen"),
  addStatus: document.getElementById("addStatus")
};

function saveState(){
  localStorage.setItem(STORAGE_KEY, JSON.stringify(words));
  updateCountInfo();
  populateCategories();
}

function loadState(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    if(!raw) return [];
    const parsed = JSON.parse(raw);
    return Array.isArray(parsed) ? parsed.map((item, idx) => normalizeItem(item, idx)) : [];
  }catch(e){
    return [];
  }
}

function normalizeKategorie(rawKategorie, rawKategorieID){
  if (rawKategorieID !== undefined && rawKategorieID !== null && String(rawKategorieID).trim() !== "") {
    const id = Number(rawKategorieID);
    if (KATEGORIEN_MAP[id]) {
      return {
        Kategorie: KATEGORIEN_MAP[id],
        KategorieID: id
      };
    }
  }

  const text = String(rawKategorie ?? "").trim();
  const fromNumber = KATEGORIEN_MAP[Number(text)];
  if (fromNumber) {
    return {
      Kategorie: fromNumber,
      KategorieID: Number(text)
    };
  }

  const fromName = KATEGORIEN_REVERSE_MAP[text];
  return {
    Kategorie: text,
    KategorieID: fromName || null
  };
}

function normalizeItem(x, idx){
  const kat = normalizeKategorie(x.Kategorie, x.KategorieID);
  return {
    Nummer: Number(x.Nummer ?? idx + 1),
    Deutsch: String(x.Deutsch ?? "").trim(),
    Spanisch: String(x.Spanisch ?? "").trim(),
    Kategorie: kat.Kategorie,
    KategorieID: kat.KategorieID,
    Zaehler: Math.min(3, Math.max(1, Number(x.Zaehler ?? 1) || 1)),
    Bemerkungen: String(x.Bemerkungen ?? "").trim()
  };
}

function populateCategories(){
  const currentVal = el.category.value;
  const cats = [...new Set(words.map(w => w.Kategorie).filter(Boolean))].sort((a,b)=>a.localeCompare(b, "de"));
  el.category.innerHTML = '<option value="">Keine Präferenz</option>';
  cats.forEach(c => {
    const opt = document.createElement("option");
    opt.value = c;
    opt.textContent = c;
    el.category.appendChild(opt);
  });
  if ([...el.category.options].some(o => o.value === currentVal)) {
    el.category.value = currentVal;
  }
}

function updateCountInfo(){
  const filtered = getFilteredWords().length;
  el.countInfo.textContent = `${words.length} Wörter · ${filtered} im Filter`;
}

function updateNextButtonLabel(){
  el.nextBtn.textContent = showingSolution ? "Weiter" : "Lösung anzeigen";
}

function updateQuestionAndAnswerViews(){
  if(!current) return;

  if(el.direction.value === "de-es"){
    el.question.textContent = current.Deutsch;
    el.answer.textContent = current.Spanisch;
  } else {
    el.question.textContent = current.Spanisch;
    el.answer.textContent = current.Deutsch;
  }

  el.notes.textContent = current.Bemerkungen || "–";
  el.catLabel.textContent = current.Kategorie || "–";
  el.levelPill.textContent = `Stufe: ${current.Zaehler}`;
}

function weight(z){
  if(z === 1) return 1;
  if(z === 2) return 2;
  if(z === 3) return 4;
  return 1;
}

function ensureAtLeastOneLevel(selectedCheckbox){
  const checkedCount =
    (el.chk1.checked ? 1 : 0) +
    (el.chk2.checked ? 1 : 0) +
    (el.chk3.checked ? 1 : 0);

  if (checkedCount === 0) {
    selectedCheckbox.checked = true;
  }

  updateCountInfo();
}

function getFilteredWords(){
  const cat = el.category.value;
  const allow1 = el.chk1.checked;
  const allow2 = el.chk2.checked;
  const allow3 = el.chk3.checked;

  return words.filter(w => {
    if(!w.Deutsch || !w.Spanisch) return false;
    if(cat && w.Kategorie !== cat) return false;

    const z = Number(w.Zaehler);

    if (z === 1 && !allow1) return false;
    if (z === 2 && !allow2) return false;
    if (z === 3 && !allow3) return false;

    return true;
  });
}

function nextWord(){
  let list = getFilteredWords();

  if(list.length === 0){
    current = null;
    el.question.textContent = "Keine passenden Wörter gefunden.";
    el.solutionArea.classList.add("hidden");
    el.editArea.classList.add("hidden");
    el.levelPill.textContent = "Stufe: –";
    showingSolution = false;
    updateNextButtonLabel();
    updateCountInfo();
    return;
  }

  if(el.avoidRepeat.checked && list.length > 1 && lastNummer !== null){
    const reduced = list.filter(w => Number(w.Nummer) !== Number(lastNummer));
    if(reduced.length > 0) list = reduced;
  }

  const total = list.reduce((sum, w) => sum + weight(Number(w.Zaehler)), 0);
  let r = Math.floor(Math.random() * total) + 1;

  let running = 0;
  for(const w of list){
    running += weight(Number(w.Zaehler));
    if(r <= running){
      current = w;
      break;
    }
  }

  lastNummer = current.Nummer;
  el.solutionArea.classList.add("hidden");
  el.editArea.classList.add("hidden");

  if(el.direction.value === "de-es"){
    el.question.textContent = current.Deutsch;
  } else {
    el.question.textContent = current.Spanisch;
  }

  el.levelPill.textContent = `Stufe: ${current.Zaehler}`;
  showingSolution = false;
  updateNextButtonLabel();
  updateCountInfo();
}

function showSolution(){
  if(!current) return;
  updateQuestionAndAnswerViews();
  el.solutionArea.classList.remove("hidden");
  showingSolution = true;
  updateNextButtonLabel();
}

function changeLevel(delta){
  if(!current) return;

  const idx = words.findIndex(w => Number(w.Nummer) === Number(current.Nummer));
  if(idx < 0) return;

  let z = Number(words[idx].Zaehler) + delta;
  if(z < 1) z = 1;
  if(z > 3) z = 3;

  words[idx].Zaehler = z;
  current.Zaehler = z;
  el.levelPill.textContent = `Stufe: ${z}`;
  saveState();
}

function exportCSV(){
  const header = ["Nummer","Deutsch","Spanisch","Zaehler","Bemerkungen","KategorieID"];
  const rows = words.map(w => [
    w.Nummer,
    w.Deutsch,
    w.Spanisch,
    w.Zaehler,
    w.Bemerkungen,
    w.KategorieID ?? ""
  ]);

  const csv = [header.join(";")]
    .concat(
      rows.map(r =>
        r.map(v => `"${(v ?? "").toString().replace(/"/g,'""')}"`).join(";")
      )
    )
    .join("\n");

  const BOM = "\uFEFF";
  const blob = new Blob([BOM + csv], {type: "text/csv;charset=utf-8;"});
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "wortliste_export.csv";
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(a.href);
}

function detectDelimiter(text){
  const firstLine = text.split(/\r?\n/).find(line => line.trim() !== "") || "";
  const semicolons = (firstLine.match(/;/g) || []).length;
  const commas = (firstLine.match(/,/g) || []).length;
  const tabs = (firstLine.match(/\t/g) || []).length;
  if (tabs >= semicolons && tabs >= commas) return "\t";
  if (semicolons >= commas) return ";";
  return ",";
}

function parseCsvLine(line, delimiter){
  const result = [];
  let currentValue = "";
  let inQuotes = false;

  for (let i = 0; i < line.length; i++){
    const ch = line[i];
    const next = line[i + 1];

    if (ch === '"'){
      if (inQuotes && next === '"'){
        currentValue += '"';
        i++;
      } else {
        inQuotes = !inQuotes;
      }
    } else if (ch === delimiter && !inQuotes){
      result.push(currentValue);
      currentValue = "";
    } else {
      currentValue += ch;
    }
  }

  result.push(currentValue);
  return result.map(v => v.trim());
}

function parseCsv(text){
  const delimiter = detectDelimiter(text);
  const lines = text
    .replace(/^\uFEFF/, "")
    .split(/\r?\n/)
    .filter(line => line.trim() !== "");

  if (!lines.length) throw new Error("CSV ist leer.");

  const headers = parseCsvLine(lines[0], delimiter).map(h => h.trim().toLowerCase());

  const findIndex = names => headers.findIndex(h => names.includes(h));
  const idxNummer = findIndex(["nummer", "id"]);
  const idxDeutsch = findIndex(["deutsch"]);
  const idxSpanisch = findIndex(["spanisch", "espanol", "español"]);
  const idxKategorie = findIndex(["kategorie", "category"]);
  const idxKategorieID = findIndex(["kategorieid", "categoryid"]);
  const idxZaehler = findIndex(["zaehler", "zähler", "stufe"]);
  const idxBemerkungen = findIndex(["bemerkungen", "bemerkung", "notiz", "notizen", "notes"]);

  if (idxDeutsch < 0 || idxSpanisch < 0){
    throw new Error("CSV braucht mindestens die Spalten Deutsch und Spanisch.");
  }

  const items = [];
  for (let i = 1; i < lines.length; i++){
    const cols = parseCsvLine(lines[i], delimiter);
    const obj = {
      Nummer: idxNummer >= 0 ? cols[idxNummer] : i,
      Deutsch: idxDeutsch >= 0 ? cols[idxDeutsch] : "",
      Spanisch: idxSpanisch >= 0 ? cols[idxSpanisch] : "",
      Kategorie: idxKategorie >= 0 ? cols[idxKategorie] : "",
      KategorieID: idxKategorieID >= 0 ? cols[idxKategorieID] : "",
      Zaehler: idxZaehler >= 0 ? cols[idxZaehler] : 1,
      Bemerkungen: idxBemerkungen >= 0 ? cols[idxBemerkungen] : ""
    };
    items.push(normalizeItem(obj, i));
  }

  return items.filter(w => w.Deutsch || w.Spanisch);
}

function importJsonText(text){
  const parsed = JSON.parse(text);
  if(!Array.isArray(parsed)) throw new Error("JSON ist keine Liste.");
  return parsed.map(normalizeItem).filter(w => w.Deutsch || w.Spanisch);
}

function importText(text, filename){
  const lower = (filename || "").toLowerCase();
  const trimmed = text.trim();

  if (lower.endsWith(".csv") || lower.endsWith(".txt")){
    return parseCsv(text);
  }

  if (lower.endsWith(".json")){
    return importJsonText(text);
  }

  if (trimmed.startsWith("[") || trimmed.startsWith("{")){
    return importJsonText(text);
  }

  return parseCsv(text);
}

function importFile(file){
  const reader = new FileReader();
  reader.onload = function(){
    try{
      const imported = importText(reader.result, file.name);
      if (!imported.length) throw new Error("Keine gültigen Daten gefunden.");
      words = imported;
      current = null;
      lastNummer = null;
      showingSolution = false;
      saveState();
      el.solutionArea.classList.add("hidden");
      el.editArea.classList.add("hidden");
      el.question.textContent = "Import erfolgreich. Du kannst jetzt lernen.";
      el.levelPill.textContent = "Stufe: –";
      updateNextButtonLabel();
      alert("Import erfolgreich. Die Daten bleiben nun gespeichert.");
    }catch(err){
      alert("Import fehlgeschlagen: " + err.message);
    }finally{
      el.importFile.value = "";
    }
  };
  reader.readAsText(file, "utf-8");
}

function openEditArea(){
 if(!current) return;
  el.editArea.classList.remove("hidden");
  el.editDeutsch.value = current.Deutsch;
  el.editSpanisch.value = current.Spanisch;
  el.editKategorie.value = String(current.KategorieID || 5);
  el.editBemerkungen.value = current.Bemerkungen;
}

function autoSaveEdits(){
  if(!current) return;

  const idx = words.findIndex(w => Number(w.Nummer) === Number(current.Nummer));
  if(idx < 0) return;

  const katID = Number(el.editKategorie.value);

  words[idx].Deutsch = el.editDeutsch.value.trim();
  words[idx].Spanisch = el.editSpanisch.value.trim();
  words[idx].KategorieID = katID;
  words[idx].Kategorie = KATEGORIEN_MAP[katID];
  words[idx].Bemerkungen = el.editBemerkungen.value.trim();

  current = words[idx];

  updateQuestionAndAnswerViews();
  saveState();
}

function suggestCategoryId(deutsch, spanisch){
  const d = (deutsch || "").trim().toLowerCase();
  const s = (spanisch || "").trim().toLowerCase();

  if (!d && !s) return 5;

  const isVerb =
    d.endsWith("en") &&
    (s.endsWith("ar") || s.endsWith("er") || s.endsWith("ir"));

  if (isVerb) return 1;

  const isSubstantiv =
    /^(la|el|los|las|un|una)\s+/i.test(s);

  if (isSubstantiv) return 2;
  
  const isSentence =
    d.includes(" ") ||
    /[.!?¿¡]$/.test(s) ||
    /[.!?]$/.test(d);

  if (isSentence) return 6;

  return 5;
}

function updateCategorySuggestion(){
  const suggested = suggestCategoryId(el.newDeutsch.value, el.newSpanisch.value);
  el.newKategorie.value = String(suggested);
  el.addStatus.textContent = `Vorgeschlagene Kategorie: ${KATEGORIEN_MAP[suggested]}`;
  el.addStatus.className = "status ok";
}

function resetAddForm(){
  el.newDeutsch.value = "";
  el.newSpanisch.value = "";
  el.newZaehler.value = "2";
  el.newKategorie.value = "2";
  el.newBemerkungen.value = "";
  el.addStatus.textContent = "Kategorie wird automatisch vorgeschlagen und kann geändert werden.";
  el.addStatus.className = "status";
}

function openAddModal(){
  resetAddForm();
  el.addOverlay.classList.remove("hidden");
  el.newDeutsch.focus();
}

function closeAddModal(){
  el.addOverlay.classList.add("hidden");
}

function normalizeForDuplicate(text){
  return String(text || "")
    .trim()
    .toLowerCase()
    .replace(/\s+/g, " ");
}

function findDuplicate(deutsch, spanisch){
  const d = normalizeForDuplicate(deutsch);
  const s = normalizeForDuplicate(spanisch);

  return words.find(w =>
    normalizeForDuplicate(w.Deutsch) === d &&
    normalizeForDuplicate(w.Spanisch) === s
  );
}

function saveNewWord(){
  const deutsch = el.newDeutsch.value.trim();
  const spanisch = el.newSpanisch.value.trim();
  const bemerkungen = el.newBemerkungen.value.trim();
  const zaehler = Number(el.newZaehler.value);
  const katID = Number(el.newKategorie.value);

  if(!deutsch || !spanisch){
    el.addStatus.textContent = "Deutsch und Spanisch sind Pflichtfelder.";
    el.addStatus.className = "status err";
    return;
  }

  const duplicate = findDuplicate(deutsch, spanisch);
  if (duplicate){
    el.addStatus.textContent = `Dublette gefunden: ${duplicate.Deutsch} → ${duplicate.Spanisch}`;
    el.addStatus.className = "status err";
    return;
  }

  const neueNummer = words.length
    ? Math.max(...words.map(w => Number(w.Nummer) || 0)) + 1
    : 1;

  const neuesWort = {
    Nummer: neueNummer,
    Deutsch: deutsch,
    Spanisch: spanisch,
    Kategorie: KATEGORIEN_MAP[katID],
    KategorieID: katID,
    Zaehler: zaehler,
    Bemerkungen: bemerkungen
  };

  words.push(neuesWort);
  saveState();
  populateCategories();

  current = neuesWort;
  lastNummer = neuesWort.Nummer;
  showingSolution = false;

  if(el.direction.value === "de-es"){
    el.question.textContent = current.Deutsch;
  } else {
    el.question.textContent = current.Spanisch;
  }

  el.solutionArea.classList.add("hidden");
  el.editArea.classList.add("hidden");
  el.levelPill.textContent = `Stufe: ${current.Zaehler}`;
  updateNextButtonLabel();
  updateCountInfo();

  closeAddModal();
}

el.importFile.addEventListener("change", e => {
  const file = e.target.files && e.target.files[0];
  if(file) importFile(file);
});

el.nextBtn.addEventListener("click", () => {
  if(!current || showingSolution){
    nextWord();
  } else {
    showSolution();
  }
});

el.exportBtn.addEventListener("click", exportCSV);
el.easierBtn.addEventListener("click", () => changeLevel(-1));
el.harderBtn.addEventListener("click", () => changeLevel(1));
el.editBtn.addEventListener("click", openEditArea);

el.editDeutsch.addEventListener("input", autoSaveEdits);
el.editSpanisch.addEventListener("input", autoSaveEdits);
el.editBemerkungen.addEventListener("input", autoSaveEdits);
el.editKategorie.addEventListener("change", autoSaveEdits);

[el.category, el.avoidRepeat, el.direction].forEach(node => {
  node.addEventListener("change", () => {
    updateCountInfo();
    if(current){
      updateQuestionAndAnswerViews();
    }
  });
});

[el.chk1, el.chk2, el.chk3].forEach(node => {
  node.addEventListener("change", () => {
    ensureAtLeastOneLevel(node);
    if(current){
      updateQuestionAndAnswerViews();
    }
  });
});

el.addBtn.addEventListener("click", openAddModal);
el.closeAddBtn.addEventListener("click", closeAddModal);
el.cancelNewBtn.addEventListener("click", closeAddModal);
el.saveNewBtn.addEventListener("click", saveNewWord);

el.newDeutsch.addEventListener("input", updateCategorySuggestion);
el.newSpanisch.addEventListener("input", updateCategorySuggestion);

el.addOverlay.addEventListener("click", (e) => {
  if (e.target === el.addOverlay) closeAddModal();
});

words = loadState();
populateCategories();
updateCountInfo();
updateNextButtonLabel();

if(words.length > 0){
  el.question.textContent = "Gespeicherte Daten gefunden. Du kannst direkt starten.";
} else {
  el.question.textContent = "Bitte zuerst eine CSV- oder JSON-Datei importieren.";
}
</script>
</body>
</html>
